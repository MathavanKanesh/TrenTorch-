import numpy as np

def solve(X):
    array = np.array(X, dtype=float)
    mean = np.mean(array)
    std = np.std(array)

    if std == 0: # If std = 0 then no spread and should return a row of 0s
        return np.zeros_like(array)

    for i in range(len(array)):
        array[i][0] = (array[i][0] - mean) / std

    return array

print(solve([[1.0], [2.0], [3.0]]))